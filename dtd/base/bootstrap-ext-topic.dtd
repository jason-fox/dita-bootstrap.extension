<!ENTITY % xref "xref | %bootstrap-d-xref;">
<!ENTITY % li "li | %bootstrap-d-li; | %bootstrap-ext-d-li;">
<!ENTITY % ul "ul | %bootstrap-d-ul; | %bootstrap-ext-d-ul;">
