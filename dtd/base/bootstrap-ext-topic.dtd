<!ENTITY % fig          "fig |
                         %ut-d-fig; |
                         %pr-d-fig;
                        ">
<!ENTITY % data         "data |
                         %ut-d-data;
                        ">
<!ENTITY % index-base   "index-base |
                         %indexing-d-index-base;
                        ">
<!ENTITY % note         "note |
                         %hazard-d-note;
                        ">
<!ENTITY % keyword      "keyword |
                         %xml-d-keyword; |
                         %pr-d-keyword; | %sw-d-keyword; | %ui-d-keyword;
                        ">
<!ENTITY % pre          "pre |
                         %pr-d-pre; | %sw-d-pre; | %ui-d-pre;
                        ">
<!ENTITY % dl           "dl |
                         %pr-d-dl;
                        ">
<!ENTITY % bodydiv      "bodydiv | %bootstrap-d-bodydiv; | %bootstrap-ext-d-bodydiv;">
<!ENTITY % section      "section | %bootstrap-d-section; | %bootstrap-ext-d-section;">

