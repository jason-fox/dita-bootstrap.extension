<!DOCTYPE topic PUBLIC "-//Infotexture//DTD DITA Bootstrap Extension Topic//EN" "bootstrap-ext-topic.dtd">
<topic id="whitebox">
  <title>Whitebox Gallery</title>
  <shortdesc>Use <xmlelement>whitebox</xmlelement> to hold images and create a whitebox gallery
    component.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <indexterm>Whitebox Gallery</indexterm>
        <indexterm>CSS
          <indexterm><xmlatt>outputclass</xmlatt></indexterm>
        </indexterm>
        <indexterm><xmlelement>whitebox</xmlelement></indexterm>
        <indexterm><xmlelement>whitebox-item</xmlelement></indexterm>
        <indexterm><xmlelement>image</xmlelement></indexterm>
      </keywords>
    </metadata>
  </prolog>
  <body outputclass="language-markup">
    <bodydiv outputclass="bd-example" deliveryTarget="html">
      <p>click on the image below</p>
      <whitebox>
        <whitebox-item>
          <image scope="external" href="https://picsum.photos/1200/600?a"/>
        </whitebox-item>
        <whitebox-item>
          <image scope="external" href="https://picsum.photos/1200/600?b"/>
        </whitebox-item>
        <whitebox-item>
          <image scope="external" href="https://picsum.photos/1200/600?c"/>
        </whitebox-item>
      </whitebox>
    </bodydiv>
    <tabbed-dialog style="pills" margin="t3">
      <section>
        <title>Specialization</title>
        <codeblock>&lt;whitebox&gt;
  &lt;whitebox-item&gt;
    &lt;image href="..."/&gt;
  &lt;/whitebox-item&gt;
  &lt;whitebox-item&gt;
    &lt;image href="..."/&gt;
  &lt;/whitebox-item&gt;
  &lt;whitebox-item&gt;
    &lt;image href="..."/&gt;
  &lt;/whitebox-item&gt;
&lt;/whitebox&gt;</codeblock>
      </section>
      <section>
        <title><xmlatt>outputclass</xmlatt></title>
        <codeblock>&lt;ol outputclass="whitebox"&gt;
  &lt;li&gt;
    &lt;image href="..."/&gt;
  &lt;/li&gt;
  &lt;li&gt;
    &lt;image href="..."/&gt;
  &lt;/li&gt;
  &lt;li&gt;
    &lt;image href="..."/&gt;
  &lt;/li&gt;
&lt;/ol&gt;</codeblock>
      </section>
    </tabbed-dialog>
    <section>
      <title>Whitebox Gallery Titles</title>
      <p>Use the <xmlelement>alt</xmlelement> element to display a title with each image.</p>
    </section>
    <bodydiv outputclass="bd-example" deliveryTarget="html">
      <p>click on the image below</p>
      <whitebox>
        <whitebox-item>
          <image scope="external" href="https://picsum.photos/1200/600?d">
            <alt>First Image</alt>
          </image>
        </whitebox-item>
        <whitebox-item>
          <image scope="external" href="https://picsum.photos/1200/600?e">
            <alt>Second Image</alt>
          </image>
        </whitebox-item>
        <whitebox-item>
          <image scope="external" href="https://picsum.photos/1200/600?f">
            <alt>Third Image</alt>
          </image>
        </whitebox-item>
      </whitebox>
    </bodydiv>
    <tabbed-dialog style="pills" margin="t3">
      <section>
        <title>Specialization</title>
        <codeblock>&lt;whitebox&gt;
  &lt;whitebox-item&gt;
    &lt;image href="..."&gt;
      &lt;alt&gt;First Image&lt;/alt&gt;
    &lt;/image&gt;
  &lt;/whitebox-item&gt;
  &lt;whitebox-item&gt;
    &lt;image href="..."&gt;
      &lt;alt&gt;Second Image&lt;/alt&gt;
    &lt;/image&gt;
  &lt;/whitebox-item&gt;
  &lt;whitebox-item&gt;
    &lt;image href="..."&gt;
      &lt;alt&gt;Third Image&lt;/alt&gt;
    &lt;/image&gt;
  &lt;/whitebox-item&gt;
&lt;/whitebox&gt;</codeblock>
      </section>
      <section>
        <title><xmlatt>outputclass</xmlatt></title>
        <codeblock>&lt;ol outputclass="whitebox"&gt;
  &lt;li&gt;
    &lt;image href="..."&gt;
      &lt;alt&gt;First Image&lt;/alt&gt;
    &lt;/image&gt;
  &lt;/li&gt;
  &lt;li&gt;
    &lt;image href="..."&gt;
      &lt;alt&gt;Second Image&lt;/alt&gt;
    &lt;/image&gt;
  &lt;/li&gt;
  &lt;li&gt;
    &lt;image href="..."&gt;
      &lt;alt&gt;Third Image&lt;/alt&gt;
    &lt;/image&gt;
  &lt;/li&gt;
&lt;/ol&gt;</codeblock>
      </section>
    </tabbed-dialog>
  </body>
</topic>
